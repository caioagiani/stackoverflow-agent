{
  "name": "stackoverflow-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent to triage, draft and post Stack Overflow answers (node.js, php, python)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "auth": "node src/auth.js",
    "feed": "node src/feed.js",
    "question": "node src/question.js",
    "publish": "node src/publish.js",
    "me": "node src/auth.js --status",
    "timeline": "node src/timeline.js",
    "edit": "node src/edit.js",
    "comment": "node src/comment.js",
    "vote": "node src/vote.js"
  }
}
