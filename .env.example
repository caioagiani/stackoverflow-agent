# Stack Apps -> https://stackapps.com/apps/oauth/register
# Depois de registrar, abra "Manage OAuth" no app e habilite:
#   - Non-Web Redirect URL (redirect_uri = https://stackexchange.com/oauth/login_success)
#   - Implicit flow
SO_CLIENT_ID=
SO_KEY=

# Site alvo. stackoverflow, pt.stackoverflow, serverfault, etc.
SO_SITE=stackoverflow

# Redirect do OAuth. Tem que estar sob o domínio registrado do app.
# Sem domínio próprio, ligue "Non-Web Client OAuth Redirect URI" no painel e use
# https://stackexchange.com/oauth/login_success
SO_REDIRECT_URI=

# Opcional: só é usado se você optar pelo authorization code flow.
SO_CLIENT_SECRET=
