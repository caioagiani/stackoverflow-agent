# Stack Apps -> https://stackapps.com/apps/oauth/register
# After registering, open "Manage OAuth" on the app and enable:
#   - Non-Web Redirect URL (redirect_uri = https://stackexchange.com/oauth/login_success)
#   - Implicit flow
SO_CLIENT_ID=
SO_KEY=

# Target site. stackoverflow, pt.stackoverflow, serverfault, etc.
SO_SITE=stackoverflow

# OAuth redirect. Has to sit under the app's registered domain.
# Without your own domain, enable "Non-Web Client OAuth Redirect URI" in the panel
# and use https://stackexchange.com/oauth/login_success
SO_REDIRECT_URI=

# Optional: only used if you go with the authorization code flow.
SO_CLIENT_SECRET=
